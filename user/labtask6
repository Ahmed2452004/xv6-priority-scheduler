#include "kernel/types.h"
#include "user/user.h"

int main() {
    int fds[2];   // file descriptors for pipe
    int pid;
    char message[] = "Hello from child process!\n";
    char buffer[100];

    // 1. Create message before fork (already done above)

    // 2. Create pipe
    pipe(fds);

    // 3. Fork process
    pid = fork();

    if (pid < 0) {
        printf("Error: fork failed\n");
        exit(1);
    }

    else if (pid == 0) {
        // 🔹 Child process

        // 6. Close unused read end
        close(fds[0]);

        // 4. Send message using write()
        write(fds[1], message, sizeof(message));

        // Close write end after sending
        close(fds[1]);

        exit(0);
    }

    else {
        // 🔹 Parent process

        // 6. Close unused write end
        close(fds[1]);

        // 5. Receive message using read()
        int n = read(fds[0], buffer, sizeof(buffer));

        // Print using write()
        write(1, buffer, n);

        // Close read end
        close(fds[0]);

        // 7. Wait for child
        wait(0);

        printf("Parent: child finished\n");
    }

    exit(0);
}
